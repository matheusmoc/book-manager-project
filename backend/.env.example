# Application
NODE_ENV=development
PORT=3000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# ========================================
# Database Configuration
# ========================================

# Option 1: AWS PostgreSQL (Vercel Deployment)
# Use estas variáveis quando fazer deploy no Vercel com AWS Aurora PostgreSQL
PGHOST=your-db-host.rds.amazonaws.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password
PGDATABASE=postgres
PGSSLMODE=require
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
AWS_RESOURCE_ARN=arn:aws:rds:region:account:cluster:name
AWS_ROLE_ARN=arn:aws:iam::account:role/name

# Option 2: Custom PostgreSQL (Local/Docker)
# Use estas variáveis para desenvolvimento local ou outros ambientes
# DATABASE_TYPE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=book_manager

# Option 3: SQLite (Fallback)
# Se nenhuma opção acima estiver configurada, usa SQLite automaticamente
# DATABASE_TYPE=sqlite
# DATABASE_NAME=database.sqlite
